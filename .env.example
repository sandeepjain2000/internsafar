# Copy to .env.local on your machine (gitignored). On EC2 use .env in ~/internship-portal.
# Never commit real secrets.

# --- Required (production) ---
DATABASE_URL=postgresql://user:password@host:5432/internsafar
# Local / Vercel on Supabase: use the TRANSACTION pooler (port 6543), not the session pooler (5432).
# Session mode caps all processes at pool_size (15) and fails with EMAXCONNSESSION under load.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
# Optional: cap pg Pool size (default: 1 on Vercel, 3 on Neon/pooler, else 10)
# PG_POOL_MAX=3
NEXTAUTH_URL=https://internsafar.com
NEXTAUTH_SECRET=generate-a-long-random-string

# --- Google OAuth (register verify + linked home login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---
NEXT_PUBLIC_APP_URL=https://internsafar.com
# DATABASE_SSL_CA=/path/to/global-bundle.pem

# --- Mail (Zepto or SMTP) ---
# ZEPTOMAIL_API_KEY=
# ZEPTOMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- QA only (local / CI — never enable on Vercel production) ---
# IP_QA_2FA_LOGIN_CODE=
# IP_QA_EMAIL_CHANGE_CODE=
# Expose qaVerifyUrl + qaOutboundMails on employer register (blocked when VERCEL_ENV=production)
# IP_QA_EMPLOYER_EMAIL_VERIFY_TOKEN_IN_RESPONSE=1
# QA sign-in passwords for scripts / Playwright (scripts/lib/ipCoreSampleConfig.js). Quote values containing #.
# IP_QA_CORE_PASSWORD=
# IP_QA_SUPERADMIN_PASSWORD=

# --- NVIDIA Help Chatbot (server-side only; never NEXT_PUBLIC_*) ---
# Local: put key JSON outside the app tree (never commit secrets into internship-portal/).
# Preferred: UIUX Migration/.local-secrets/nvidia_keys/key-NN.json  OR set NVIDIA_KEYS_DIR.
# Also supported: UIUX Migration/nvidia keys/ (legacy folder name with a space).
# Vercel/production: set NVIDIA_API_KEY (and optional NVIDIA_MODEL) — no key files on the host.
# NVIDIA_KEYS_DIR=
# NVIDIA_API_KEY=
# NVIDIA_API_KEYS=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TIMEOUT_MS=35000
# placementhubsupport quota ≈ 40 rpm (throttle is best-effort per server instance)
# NVIDIA_RPM_LIMIT=40
# --- Ops failure alerts (unexpected crashes / NVIDIA keys auth-dead) ---
# IP_OPS_ALERT_EMAIL=placementhubsupport@gmail.com
# IP_OPS_ALERT_COOLDOWN_MS=1800000

# --- Daily progress report (Zepto → placementhubsupport@gmail.com) ---
# AWS: 9pm IST via EC2 crontab (PRODUCTION). Vercel: 9pm IST via cron 30 15 * * * UTC (TESTING).
# IP_DAILY_PROGRESS_REPORT_TO=placementhubsupport@gmail.com
# IP_DAILY_PROGRESS_REPORT_ENABLED=true
# IP_CRON_SECRET=shared-secret
# CRON_SECRET=same-as-IP_CRON_SECRET-on-vercel  # Vercel sends Authorization: Bearer
# IP_BOOTSTRAP_SECRET=server-only-bootstrap-secret  # required for POST /api/ip/bootstrap (or SuperAdmin session)

# --- Weekly employer documents reminder (pending employers with no documents, max 2 per employer) ---
# AWS only: Monday 10:00 IST via EC2 crontab (30 4 * * 1 UTC). Leave unset on local/Vercel (shared test DB).
# IP_EMPLOYER_DOCS_REMINDER_ENABLED=true
